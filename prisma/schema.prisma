datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  displayOrder Int      @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([displayOrder])
}

model Product {
  id                    String   @id @default(cuid())
  name                  String
  slug                  String   @unique
  shortDescription      String
  fullDescription       String
  categoryId            String
  category              Category @relation(fields: [categoryId], references: [id])
  price                 Float
  compareAtPrice        Float?
  images                String   // JSON string array of image URLs
  colors                String?  // JSON string array of colors
  sizes                 String?  // JSON string array of sizes
  material              String   @default("PLA+")
  weight                String?
  dimensions            String?
  shippingFee           Float?   @default(0)
  stockQuantity         Int      @default(10)
  stockStatus           String   @default("IN_STOCK") // IN_STOCK, LOW_STOCK, OUT_OF_STOCK
  isFeatured            Boolean  @default(false)
  isNew                 Boolean  @default(false)
  isPublished           Boolean  @default(true)
  personalizationEnabled Boolean @default(false)
  customTextEnabled     Boolean  @default(false)
  tags                  String?  // JSON string array or comma separated
  displayOrder          Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([isPublished, displayOrder])
  @@index([categoryId])
  @@index([isPublished, categoryId])
}

model Order {
  id             String   @id // e.g., SNZ-10492
  customerName   String
  whatsapp       String
  email          String?
  address        String
  city           String
  state          String
  pincode        String
  orderNotes     String?
  items          String   // JSON array of items {productId, name, price, quantity, color, size, personalizedText}
  subtotal       Float
  discountAmount Float    @default(0)
  totalAmount    Float
  couponCode     String?
  referralCode   String?
  status         String   @default("PENDING") // PENDING, CONFIRMED, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CustomRequest {
  id                String   @id // e.g., SNZ-REQ-1082
  customerName      String
  whatsapp          String
  email             String?
  fileUrl           String?
  fileName          String?
  referenceImageUrl String?
  productType       String
  materialPreference String  @default("PLA+")
  colorPreference    String  @default("White")
  quantity          Int      @default(1)
  dimensions        String?
  additionalNotes   String?
  quotedPrice       Float?   @default(0)
  status            String   @default("PENDING") // PENDING, QUOTED, IN_PRODUCTION, COMPLETED, REJECTED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  discountType   String    // PERCENTAGE or FIXED
  discountValue  Float
  minOrderValue  Float     @default(0)
  maxDiscount    Float?
  usageLimit     Int       @default(100)
  timesUsed      Int       @default(0)
  perUserLimit   Int       @default(1)
  expiryDate     DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Referral {
  id             String   @id @default(cuid())
  referralCode   String   @unique // e.g. SenAZ-MILAN
  referrerName   String
  referrerContact String?
  totalReferrals Int      @default(0)
  totalOrderValue Float   @default(0)
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique // e.g., "homepage", "about", "contact"
  content   String   // JSON object storing dynamic content fields
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Receipt {
  id                String   @id @default(cuid())
  receiptNumber     String   @unique
  docType           String   @default("INVOICE") // INVOICE, ADVANCE_RECEIPT, QUOTATION, DELIVERY_RECEIPT
  customerName      String
  whatsapp          String
  email             String?
  address           String?
  city              String?
  state             String?
  pincode           String?
  customerNotes     String?
  adminBusinessInfo String?  // JSON string storing studio name, address, contact, etc.
  items             String   // JSON string array of ReceiptItem
  subtotal          Float
  discountAmount    Float    @default(0)
  shippingFee       Float    @default(0)
  taxPercent        Float    @default(0)
  grandTotal        Float
  advancePaid       Float    @default(0)
  balanceDue        Float    @default(0)
  paymentStatus     String   @default("PAID_IN_FULL")
  paymentMode       String   @default("UPI / Online")
  upiId             String   @default("918761053230@upi")
  estimatedDelivery String?  @default("3-5 Business Days")
  issueDate         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([createdAt])
  @@index([customerName])
}
